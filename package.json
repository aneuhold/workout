{
  "name": "workout",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "dev:android": "concurrently --kill-others --names vite,android \"vite dev\" \"pnpm cap run android --live-reload --port 5173 --host localhost --forwardPorts 5173:5173 --target-name 'OnePlus IN2025'\"",
    "open:android": "pnpm cap open android",
    "build": "vite build",
    "build:sb": "storybook build",
    "build:android": "pnpm build && pnpm cap sync android",
    "push:android": "pnpm cap run android",
    "preview": "pnpm build && vite preview --port 5173",
    "preview:android": "pnpm build:android && pnpm push:android",
    "lint": "eslint --cache",
    "test": "vitest run",
    "check": "svelte-check && pnpm check:circular",
    "check:circular": "madge --circular --extensions ts,svelte src/",
    "check:visual": "madge --image deps.svg --extensions ts,svelte src/",
    "upgrade:core": "pnpm up '@aneuhold/*' --latest",
    "storybook": "storybook dev -p 6006",
    "sub": "pnpm sub:core-ts-api-lib",
    "unsub": "local-npm unsubscribe",
    "sub:core-ts-api-lib": "local-npm subscribe @aneuhold/core-ts-api-lib",
    "sub:core-ts-db-lib": "local-npm subscribe @aneuhold/core-ts-db-lib",
    "sub:eslint-config": "local-npm subscribe @aneuhold/eslint-config",
    "unsub:core-ts-api-lib": "local-npm unsubscribe @aneuhold/core-ts-api-lib",
    "unsub:eslint-config": "local-npm unsubscribe @aneuhold/eslint-config",
    "generate:icons": "tsx scripts/generate-icons.ts"
  },
  "scriptsComments": {
    "dev:android": "Vite binds to localhost only (vs using --host, which binds to 0.0.0.0). '--forwardPorts 5173:5173' tells Capacitor to run 'adb reverse tcp:5173 tcp:5173' so the device's localhost:5173 forwards to the Mac's. '--host localhost' pins the live-reload URL so the WebView origin is http://localhost:5173 which is already in the backend's CORS allowlist, so we can hit prod without running gcloud-backend locally in hot-reload mode. '--target-name' avoids the interactive emulator prompt. Possible names: 'Pixel 10 Pro XL', 'OnePlus IN2025', 'Pixel 6'"
  },
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "license": "BUSL-1.1",
  "dependencies": {
    "@sentry/sveltekit": "^10.43.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@aneuhold/core-ts-api-lib": "^3.0.36",
    "@aneuhold/core-ts-db-lib": "^5.0.8",
    "@aneuhold/core-ts-lib": "^2.4.4",
    "@aneuhold/eslint-config": "^2.0.5",
    "@aneuhold/local-npm-registry": "^0.2.32",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.20",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.11.0",
    "@neoconfetti/svelte": "^2.2.2",
    "@sentry/capacitor": "^4.0.0",
    "@storybook/addon-docs": "^10.2.7",
    "@storybook/addon-links": "^10.2.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.2.8",
    "@storybook/sveltekit": "^10.2.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tabler/icons-svelte": "^3.41.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "bits-ui": "^2.15.5",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "culori": "^4.0.2",
    "d3-scale": "^4.0.2",
    "eslint": "^9.0.0",
    "eslint-plugin-storybook": "10.2.7",
    "jsdom": "^29.0.2",
    "layerchart": "2.0.0-next.43",
    "madge": "^8.0.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "shadcn": "^3.8.4",
    "smui-theme": "^8.0.3",
    "storybook": "^10.2.7",
    "svelte": "^5.50.0",
    "svelte-check": "^4.4.6",
    "svelte-dnd-action": "^0.9.69",
    "svg2vectordrawable": "^2.9.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.4"
  },
  "devDependenciesComments": {
    "svg2vectordrawable": "Used by scripts/generate-icons-android.ts to convert the splash logo SVG into an Android <vector> drawable for windowSplashScreenAnimatedIcon. Android's official converter (vd-tool) ships with Android Studio and requires the SDK; this is the practical npm equivalent. The alternative — rasterizing to multi-density PNGs via sharp — would force every icon-generation run to write out 6+ density variants, while a single vector drawable scales across all DPIs.",
    "culori": "Used by scripts/generate-icons-utils.ts to convert the OKLCH --background tokens from src/globalStyles/global.css into the sRGB hex values that Android's splash_screen_background color resource requires."
  }
}
