{
  "name": "workout",
  "version": "1.1.6",
  "scripts": {
    "dev": "vite dev",
    "dev:android": "tsx scripts/dev-android.ts",
    "open:android": "pnpm cap open android",
    "build": "vite build && tsx scripts/replaceDevVersion.ts && tsx scripts/emitVersionInfo.ts",
    "build:sb": "storybook build",
    "build:android": "pnpm build && pnpm cap sync android",
    "push:android": "pnpm cap run android",
    "preview": "pnpm build && vite preview --port 5173",
    "preview:android": "pnpm build:android && pnpm push:android",
    "publish:android:validate": "cd android && ./gradlew signingReport",
    "publish:android:build": "tsx scripts/publishAndroidBuild.ts 'pnpm build:android' 'cd android && ./gradlew bundleRelease'",
    "lint": "eslint --cache",
    "test": "vitest run",
    "test:perf": "pnpm test:perf:seed && tsx scripts/perf/runPerf.ts",
    "test:perf:seed": "vitest run -c vite.perf.config.ts",
    "check": "svelte-check && pnpm check:circular",
    "check:circular": "madge --circular --extensions ts,svelte src/",
    "check:visual": "madge --image deps.svg --extensions ts,svelte src/",
    "upgrade:core": "pnpm up '@aneuhold/*' --latest",
    "storybook": "storybook dev -p 6006",
    "sub": "pnpm sub:core-ts-api-lib",
    "unsub": "local-npm unsubscribe",
    "sub:core-ts-api-lib": "local-npm subscribe @aneuhold/core-ts-api-lib",
    "sub:core-ts-db-lib": "local-npm subscribe @aneuhold/core-ts-db-lib",
    "sub:eslint-config": "local-npm subscribe @aneuhold/eslint-config",
    "unsub:core-ts-api-lib": "local-npm unsubscribe @aneuhold/core-ts-api-lib",
    "unsub:eslint-config": "local-npm unsubscribe @aneuhold/eslint-config",
    "generate:icons": "tsx scripts/generate-icons.ts"
  },
  "scriptsComments": {},
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "license": "BUSL-1.1",
  "dependencies": {
    "@sentry/sveltekit": "10.60.0",
    "socket.io-client": "^4.8.3"
  },
  "dependenciesComments": {
    "@sentry/sveltekit": "Pinned exactly to the `@sentry/browser` / `@sentry/core` version that `@sentry/capacitor` depends on (it pins those exactly rather than by range). `SentryCapacitor.init(options, Sentry.init)` in src/hooks.client.ts passes a client between the two SDKs, so a mismatch resolves two copies of `@sentry/core` and the `Client` types stop being assignable. Bump this and `@sentry/capacitor` together."
  },
  "devDependencies": {
    "@aneuhold/core-ts-api-lib": "^3.0.43",
    "@aneuhold/core-ts-db-lib": "^5.0.12",
    "@aneuhold/core-ts-lib": "^2.4.8",
    "@aneuhold/eslint-config": "^3.0.2",
    "@aneuhold/local-npm-registry": "^1.0.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.3.40",
    "@fontsource-variable/inter": "^5.3.0",
    "@inquirer/prompts": "^8.5.2",
    "@internationalized/date": "^3.12.3",
    "@neoconfetti/svelte": "^2.2.2",
    "@playwright/test": "^1.62.1",
    "@sentry/capacitor": "^4.2.0",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/sveltekit": "^10.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tabler/icons-svelte": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/culori": "^4.0.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "culori": "^4.0.2",
    "d3-scale": "^4.0.2",
    "devtools-protocol": "^0.0.1674729",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "10.5.7",
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "jsdom": "^30.0.1",
    "layerchart": "2.0.0-next.43",
    "madge": "^8.0.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "smui-theme": "^9.0.3",
    "storybook": "^10.5.7",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-dnd-action": "^0.9.78",
    "svg2vectordrawable": "^2.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  },
  "devDependenciesComments": {
    "svg2vectordrawable": "Used by scripts/generate-icons-android.ts to convert the splash logo SVG into an Android <vector> drawable for windowSplashScreenAnimatedIcon. Android's official converter (vd-tool) ships with Android Studio and requires the SDK; this is the practical npm equivalent. The alternative — rasterizing to multi-density PNGs via sharp — would force every icon-generation run to write out 6+ density variants, while a single vector drawable scales across all DPIs.",
    "culori": "Used by scripts/generate-icons-utils.ts to convert the OKLCH --background tokens from src/globalStyles/global.css into the sRGB hex values that Android's splash_screen_background color resource requires.",
    "devtools-protocol": "Provides the `Protocol` namespace used in testUtils/perfTestUtils.ts to type the CDP throttling inputs (`Network.emulateNetworkConditionsRequest`, `Emulation.SetCPUThrottlingRateRequest`). Playwright depends on this transitively but doesn't re-export it."
  }
}
